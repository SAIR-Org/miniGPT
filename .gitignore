# ═════════════════════════════════════════════
# miniGPT — .gitignore
# ═════════════════════════════════════════════

# ── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# ── Data (generated by `sair prepare`) ────────
data/raw/
data/processed/
data/classification-processed/

# ── Model checkpoints (large binaries) ────────
checkpoints/*.pt
checkpoints/*.pth
checkpoints/*.png
checkpoints/*.safetensors
checkpoints/models--*/
checkpoints/CACHEDIR.TAG

# ── Experiment tracking ───────────────────────
wandb/
mlruns/
mlartifacts/
lightning_logs/

# ── Debug logs ────────────────────────────────
*.log
tea_debug.log

# ── Environment / secrets ─────────────────────
.env
.env.local
.env.*.local

# ── IDE / OS ──────────────────────────────────
.vscode/
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
